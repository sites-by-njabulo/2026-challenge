# These are the settings the tracker needs. On Vercel you add them in the project settings (Settings, Environment Variables).
# Do NOT put real values in this file and do NOT commit a real .env file.

# Supabase: Project Settings, Database, Connection string, Transaction pooler (port 6543), with your database password filled in.
# If the password has symbols, write them URL-encoded (@ becomes %40, # becomes %23, / becomes %2F, : becomes %3A).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# Any long random string (40 or more characters). It locks the saved Zapmail key. Do not change it later, or the key must be pasted again.
APP_SECRET=

# Any code you pick (8 or more characters). Asked once, the very first time you set your password.
SETUP_TOKEN=

# Any long random string (16 or more characters). Lets Vercel's once-a-day Zapmail refresh in. Vercel sends it by itself.
CRON_SECRET=

# Only for trying the app on your own computer without Supabase: TEST_PGLITE=1 gives a throwaway in-memory database.
# TEST_PGLITE=1
